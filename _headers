# Netlify leser denne filen fra publiseringsmappen og legger headerne på svarene.
# Sjekk resultatet på https://securityheaders.com etter publisering.
#
# Content-Security-Policy sier hvor siden får hente innhold fra, og hvilken kode
# som får kjøre. Innebygde <script>- og <style>-blokker får bare kjøre hvis hashen
# deres står i regelen. Den fyller bygg.py inn automatisk der det står
# merkene «HASHER-FOR-…» i regelen under (ikke fjern dem). Derfor:
#   • Ikke bruk onclick="…", style="…" eller javascript:-lenker i HTML-en. Bygg-
#     ingen stopper med en feilmelding hvis dere gjør det. Bruk klasser og
#     addEventListener i <script>-blokken i stedet.
#   • Alt ligger på dotdev.no i dag. Tar dere i bruk noe eksternt, må det
#     legges til her:
#   • Bookingsiden i Google Kalender (BOOKING.externalUrl) er bare en lenke som
#     åpnes i ny fane: trengs ingen endring
#   • Innebygd kalender, video, analyse o.l.: legg til domenet i riktig direktiv
#   • Kundeportalen (/api/kunde/…) ligger på dotdev.no, så den trenger ingen endring.
#     Svarene fra serverfunksjonen får sine egne headere (Netlify bruker ikke denne
#     filen på dem), se netlify/functions/kunde-api.mjs.
#
# Strict-Transport-Security: nettleseren bruker bare HTTPS i to år, også på alle
# underdomener. Et nytt underdomene må derfor ha gyldig HTTPS fra første dag (se
# «Sikkerhet» i LES-MEG.md).

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), autoplay=(), bluetooth=(), browsing-topics=(), camera=(), display-capture=(), geolocation=(), gyroscope=(), hid=(), magnetometer=(), microphone=(), midi=(), payment=(), publickey-credentials-get=(), serial=(), usb=(), xr-spatial-tracking=()
  Content-Security-Policy: default-src 'self'; script-src 'self' HASHER-FOR-SKRIPT; style-src 'self' HASHER-FOR-STIL; img-src 'self'; font-src 'self'; connect-src 'self'; form-action 'self'; frame-src 'none'; worker-src 'none'; frame-ancestors 'none'; base-uri 'none'; object-src 'none'; upgrade-insecure-requests
  Cross-Origin-Opener-Policy: same-origin
  X-Permitted-Cross-Domain-Policies: none
  Strict-Transport-Security: max-age=63072000; includeSubDomains

# Fonter endrer aldri innhold (nye fonter får nye filnavn): ett år i nettleserens mellomlager.
# Én blokk per fil, ikke /fonter/*: da ville også en 404 for en feilskrevet fontadresse
# bli lagret i ett år. Legger dere til en font, legg den til her også.
/fonter/inter-tight-latin.woff2
  Cache-Control: public, max-age=31536000, immutable

/fonter/inter-tight-latin-ext.woff2
  Cache-Control: public, max-age=31536000, immutable

/fonter/outfit-latin.woff2
  Cache-Control: public, max-age=31536000, immutable

/fonter/outfit-latin-ext.woff2
  Cache-Control: public, max-age=31536000, immutable

# Bilder: én uke (bytt filnavn hvis dere bytter et bilde og vil at endringen vises med en gang)
/bilder/*
  Cache-Control: public, max-age=604800

# Delingsbildet har versjon i adressen (?v=2 i <head>), så det kan også lagres en uke
/delingsbilde.png
  Cache-Control: public, max-age=604800

# Ikonene og manifestet: ett døgn, så et nytt ikon slår igjennom innen en dag.
# Manifestet får riktig type (Netlify sender det ellers som application/octet-stream).
/site.webmanifest
  Content-Type: application/manifest+json; charset=utf-8
  Cache-Control: public, max-age=86400

/favicon.ico
  Cache-Control: public, max-age=86400

/favicon.svg
  Cache-Control: public, max-age=86400

/favicon-32.png
  Cache-Control: public, max-age=86400

/apple-touch-icon.png
  Cache-Control: public, max-age=86400

/icon-192.png
  Cache-Control: public, max-age=86400

/icon-512.png
  Cache-Control: public, max-age=86400

# Kundeportalen skal ikke vises i Google
/kunde
  X-Robots-Tag: noindex

/kunde.html
  X-Robots-Tag: noindex
